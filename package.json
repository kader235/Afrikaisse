{
  "name": "afrikaisse",
  "private": true,
  "type": "module",
  "description": "AfriKaisse — Restaurant Operating System (GLOBALTECH BUSINESS TD)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev:api": "npm run dev -w @afrikaisse/api",
    "dev:web": "npm run dev -w @afrikaisse/web",
    "build:api": "npm run build -w @afrikaisse/api",
    "build:web": "npm run build -w @afrikaisse/web",
    "verify": "npm run typecheck && npm test && npm run build:api && npm run build:web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
